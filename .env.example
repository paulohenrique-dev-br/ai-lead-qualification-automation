# Copy this file to .env and fill in local/dev values.
# Never commit a real .env file.

# n8n
N8N_PORT=5678

# LLM API (OpenAI-compatible)
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-me
LLM_MODEL=gpt-4o-mini
# "json_schema" or "json_object". "json_schema" is preferred when supported.
LLM_STRUCTURED_OUTPUT_MODE=json_schema

# Supabase REST (server-side n8n only; never expose this key in a browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Demo
WEBHOOK_URL=http://localhost:5678/webhook/lead-qualification
