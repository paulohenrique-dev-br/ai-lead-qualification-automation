# Copy this file to .env and fill in local/dev values.
# Never commit a real .env file.

# n8n
N8N_PORT=5678

# DeepSeek (used by the live workflow; credential is connected in n8n)
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=deepseek-flash

# Supabase REST (server-side n8n only; never expose this key in a browser)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Demo
WEBHOOK_URL=http://localhost:5678/webhook/lead-qualification
